{
  "name": "approval-gate-mcp",
  "version": "0.1.0",
  "description": "Fail-closed human approval gates for AI agent actions, as an MCP server. Default-deny, TTL expiry, append-only audit log.",
  "mcpName": "io.github.itcustomsolution/approval-gate-mcp",
  "type": "module",
  "bin": {
    "approval-gate": "dist/cli.js",
    "approval-gate-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "human-in-the-loop",
    "governance",
    "approval",
    "guardrails",
    "mcp-server",
    "ai-safety",
    "agent-approval",
    "audit-log",
    "claude",
    "codex"
  ],
  "author": "Olufela 'Lu' Fagbure <lu@itcustomsolution.com> (https://itcustomsolution.com)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.13.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "homepage": "https://github.com/itcustomsolution/approval-gate-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itcustomsolution/approval-gate-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/itcustomsolution/approval-gate-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
